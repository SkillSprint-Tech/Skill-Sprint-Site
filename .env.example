# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Use the POOLED connection string — the host contains "-pooler". Serverless functions
# open and drop connections constantly and would exhaust a direct endpoint.
# Backs every feature: team roster, workshops, registrations, email queue.
DB_URI=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Email providers ───────────────────────────────────────────────────────────
# Resend is the primary sender (100/day on the free tier).
RESEND_API_KEY=
RESEND_FROM="SkillSprint Workshops <workshops@yourdomain.com>"

# Brevo handles overflow (~300/day on the free tier).
BREVO_API_KEY=
BREVO_FROM=workshops@yourdomain.com
BREVO_SENDER_NAME=SkillSprint Workshops

# ── Admin panel ───────────────────────────────────────────────────────────────
# The password you type into /admin. Use something long.
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Background worker ─────────────────────────────────────────────────────────
# Protects the email worker endpoint. Generate the same way as above.
CRON_SECRET=

# ── Webhooks (optional until delivery tracking is wired up) ────────────────────
RESEND_WEBHOOK_SECRET=
BREVO_WEBHOOK_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://skill-sprint.pk

# ── Existing integrations ─────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
DEFAULT_MODEL=
GOOGLE_SCRIPT_URL=
