{
  "rewrites": [
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/webhooks/:provider",
      "destination": "/api/webhooks?provider=:provider"
    },
    {
      "source": "/api/cron/process-emails",
      "destination": "/api/cron"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/cron.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
